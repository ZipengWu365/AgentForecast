{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentforecast CompareResult",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "schema_ref",
    "tool_version",
    "run_type",
    "backend_selected",
    "candidate_backends",
    "feature_spec",
    "inputs",
    "summary",
    "diagnostics",
    "metrics",
    "leaderboard",
    "artifacts",
    "warnings",
    "used_live_data"
  ],
  "properties": {
    "diagnostics": {
      "type": "object",
      "properties": {
        "conformal": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "method": {
              "type": "string"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "coverage_backtest": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "mean_interval_width": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
