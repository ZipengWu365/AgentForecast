{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentforecast CompareResult",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "schema_ref",
    "artifact_schema_version",
    "tool_version",
    "run_type",
    "backend_selected",
    "candidate_backends",
    "feature_spec",
    "inputs",
    "summary",
    "diagnostics",
    "metrics",
    "leaderboard",
    "resolution",
    "artifacts",
    "warnings",
    "used_live_data"
  ],
  "properties": {
    "kind": {
      "const": "agentforecast.compare_result"
    },
    "schema_version": {
      "type": "string"
    },
    "schema_ref": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "run_type": {
      "type": "string"
    },
    "backend_selected": {
      "type": "string"
    },
    "candidate_backends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_spec": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "leaderboard": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resolution": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "media_type",
          "description"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_live_data": {
      "type": "boolean"
    }
  }
}
