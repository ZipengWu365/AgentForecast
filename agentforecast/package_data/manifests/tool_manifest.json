          "horizon": {
            "type": "integer"
          },
          "outdir": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "backends"
        ]
      }
    },
    {
      "name": "forecast_stream_csv",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "horizon": {
            "type": "integer"
          },
          "outdir": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
