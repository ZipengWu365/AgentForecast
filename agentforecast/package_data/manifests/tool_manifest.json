            "type": "string"
          },
          "strategy": {
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ]
      }
    },
    {
      "name": "build_hosted_site",
      "input_schema": {
        "type": "object",
        "properties": {
          "runs_root": {
            "type": "string"
          },
          "site_dir": {
            "type": "string"
          }
        },
        "required": [
          "runs_root",
          "site_dir"
        ]
      }
    },
    {
      "name": "list_backends",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "route_backends",
      "input_schema": {
        "type": "object",
        "properties": {
          "history_len": {
            "type": "integer"
          },
          "horizon": {
            "type": "integer"
          },
          "strategy": {
            "type": "string"
          },
          "exogenous_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "history_len",
          "horizon"
        ]
      }
    }
  ]
}
