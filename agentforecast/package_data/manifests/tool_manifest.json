{
  "name": "agentforecast-tool-surface",
  "version": "1.8.0",
  "tools": [
    {"name": "describe_package", "input_schema": {"type": "object", "properties": {"language": {"type": "string"}}}},
    {"name": "shoot", "input_schema": {"type": "object", "properties": {"target": {"type": "string"}}}},
    {"name": "forecast_dataset", "input_schema": {"type": "object", "properties": {"dataset_id": {"type": "string"}}, "required": ["dataset_id"]}},
    {"name": "forecast_csv", "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}},
    {"name": "forecast_url", "input_schema": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]}},
    {"name": "forecast_dir", "input_schema": {"type": "object", "properties": {"directory": {"type": "string"}}, "required": ["directory"]}},
    {"name": "compare_backends_csv", "input_schema": {"type": "object", "properties": {"path": {"type": "string"}, "backends": {"type": "array", "items": {"type": "string"}}}, "required": ["path", "backends"]}},
    {"name": "forecast_stream_csv", "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}},
    {"name": "run_case", "input_schema": {"type": "object", "properties": {"case_id": {"type": "string"}}, "required": ["case_id"]}},
    {"name": "build_hosted_site", "input_schema": {"type": "object", "properties": {"runs_root": {"type": "string"}, "site_dir": {"type": "string"}}, "required": ["runs_root", "site_dir"]}},
    {"name": "list_backends", "input_schema": {"type": "object", "properties": {}}},
    {"name": "list_reviewed_backends", "input_schema": {"type": "object", "properties": {}}},
    {"name": "backend_capabilities", "input_schema": {"type": "object", "properties": {"backend_id": {"type": "string"}}, "required": ["backend_id"]}},
    {"name": "route_backends", "input_schema": {"type": "object", "properties": {"history_len": {"type": "integer"}, "horizon": {"type": "integer"}}, "required": ["history_len", "horizon"]}}
  ]
}
