          },
          "value_col": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "horizon": {
            "type": "integer"
          },
          "outdir": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "compare_backends_csv",
      "input_schema": {
        "type": "object",
        "properties": {
