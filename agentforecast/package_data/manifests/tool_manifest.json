{
  "name": "agentforecast-tool-surface",
  "version": "1.7.0",
  "tools": [
    {
      "name": "describe_package",
      "input_schema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          }
        }
      }
    },
    {
