      "input_schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "horizon": {
            "type": "integer"
          },
          "outdir": {
            "type": "string"
          }
        },
        "required": [
          "target"
        ]
      }
    },
    {
      "name": "forecast_dataset",
      "input_schema": {
        "type": "object",
